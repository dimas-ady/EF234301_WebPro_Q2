# Copy to .env and set VAULTIFY_APP_KEY before running docker compose.
# Generate a key with: openssl rand -base64 32
VAULTIFY_APP_KEY=base64:REPLACE_WITH_32_BYTE_BASE64_KEY

# Host port for the web application
APP_PORT=8080

# Prebuilt image used by compose.production.yaml
VAULTIFY_IMAGE=ghcr.io/dimas-ady/ef234301_webpro_q2:latest

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vaultify
DB_USERNAME=vaultify
DB_PASSWORD=secret
